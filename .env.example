# Exemplo de variáveis de ambiente. Nunca publique o arquivo .env real.
PORT=3001
# O valor abaixo é intencionalmente rejeitado pelo servidor. Substitua por uma chave aleatória forte.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Separe múltiplas origens por vírgula; configure apenas origens confiáveis.
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
